<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/super_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="top"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingTop="8dp"
    android:paddingEnd="10px"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.1"
        android:gravity="center_vertical|start"
        android:layout_marginTop="2dp"
        android:orientation="vertical"
        android:paddingEnd="2dp">

        <TextView
            android:id="@+id/super_temperature"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autoSizeMaxTextSize="28sp"
            android:autoSizeMinTextSize="20sp"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:gravity="start"
            android:singleLine="true"
            android:text="35°C"
            android:textColor="#00E676"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/super_clients"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start"
            android:singleLine="true"
            android:text="Clients: 0"
            android:textColor="#B0BEC5"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="2.8"
        android:gravity="center"
        android:layout_marginTop="2dp"
        android:orientation="vertical"
        android:paddingStart="2dp"
        android:paddingEnd="2dp">

        <TextView
            android:id="@+id/super_solar_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autoSizeMaxTextSize="28sp"
            android:autoSizeMinTextSize="16sp"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:gravity="center"
            android:singleLine="true"
            android:text="Mon, 24 - 10 - 2026"
            android:textColor="#00E676"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/super_lunar_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:singleLine="true"
            android:text="15 - 09 - 2026 Bính Ngọ"
            android:textColor="#B0BEC5"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.1"
        android:gravity="center_vertical|end"
        android:layout_marginTop="2dp"
        android:orientation="vertical"
        android:paddingStart="2dp">

        <TextView
            android:id="@+id/super_battery_percent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autoSizeMaxTextSize="28sp"
            android:autoSizeMinTextSize="20sp"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:gravity="end"
            android:singleLine="true"
            android:text="85%"
            android:textColor="#00E676"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/super_voltage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:singleLine="true"
            android:text="4150 mV"
            android:textColor="#B0BEC5"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
