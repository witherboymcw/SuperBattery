<?xml version="1.0" encoding="utf-8"?>
<com.witherboymcw.superbattery.awareness.NotchAwareFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/hotspot_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:clickable="true"
    android:clipChildren="false"
    android:focusable="true"
    android:visibility="gone">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/hotspot_recycler_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:nestedScrollingEnabled="true"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp" />

    <!-- Persistent Circular Back Button (pointing right to return to main) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_hotspot_back"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        app:cardBackgroundColor="?attr/colorSurface"
        app:cardCornerRadius="22dp"
        app:cardElevation="4dp"
        app:strokeColor="?attr/colorOutline"
        app:strokeWidth="0dp">

        <ImageButton
            android:id="@+id/hotspot_back_button"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/hotspot_title"
            android:padding="10dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="?attr/colorControlNormal" />
    </com.google.android.material.card.MaterialCardView>

</com.witherboymcw.superbattery.awareness.NotchAwareFrameLayout>
