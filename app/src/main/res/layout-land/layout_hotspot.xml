<?xml version="1.0" encoding="utf-8"?>
<com.witherboymcw.superbattery.awareness.NotchAwareFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/hotspot_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:clickable="true"
    android:clipChildren="false"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:baselineAligned="false"
        android:clipChildren="false"
        android:orientation="horizontal">

        <!-- Column 1 (Left): List of Hotspot Device Cards -->
        <ScrollView
            android:id="@+id/hotspot_scroll_left"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:elevation="10dp"
            android:scrollbars="none"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="8dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:id="@+id/hotspot_cards_left_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:orientation="vertical" />
        </ScrollView>

        <!-- Column 2 (Right): Selected Device Detail Panel (Non-scrollable, spans to bottom) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clipChildren="false"
            android:orientation="vertical">

            <!-- Header bar for Right Column -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp">

                <TextView
                    android:id="@+id/tv_hotspot_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:text="@string/hotspot_title"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/hotspot_back_button"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/hotspot_title"
                    android:padding="8dp"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="?attr/colorControlNormal" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/hotspot_scroll_right"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:paddingStart="8dp"
                android:paddingTop="4dp"
                android:paddingEnd="16dp"
                android:paddingBottom="24dp">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/hotspot_detail_card"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    app:cardBackgroundColor="?attr/colorSurface"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="1dp"
                    app:strokeColor="?attr/colorOutline"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <!-- Top of Detail Card shows Original Device Name -->
                        <TextView
                            android:id="@+id/hotspot_detail_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="?android:attr/textColorPrimary"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/hotspot_detail_mac"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="?android:attr/textColorSecondary"
                            android:textSize="13sp" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="10dp"
                            android:layout_marginBottom="10dp"
                            android:background="?attr/colorOutline"
                            android:alpha="0.2" />

                        <!-- Detail Card divided into 2 Columns without middle vertical line -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <!-- Section Headers Row -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="4dp"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="@string/hotspot_status_header"
                                    android:textColor="?android:attr/textColorSecondary"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="16dp"
                                    android:layout_weight="1"
                                    android:text="@string/hotspot_alias_header"
                                    android:textColor="?android:attr/textColorSecondary"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <!-- Row 1: Allowed Radio Button & Alias EditText -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="38dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <RadioButton
                                    android:id="@+id/hotspot_detail_radio_allowed"
                                    android:layout_width="0dp"
                                    android:layout_height="match_parent"
                                    android:layout_weight="1"
                                    android:gravity="center_vertical"
                                    android:paddingStart="4dp"
                                    android:paddingEnd="4dp"
                                    android:text="@string/status_allowed"
                                    android:textColor="?android:attr/textColorPrimary"
                                    android:textSize="13sp" />

                                <EditText
                                    android:id="@+id/hotspot_detail_et_alias"
                                    android:layout_width="0dp"
                                    android:layout_height="match_parent"
                                    android:layout_marginStart="16dp"
                                    android:layout_weight="1"
                                    android:autofillHints=""
                                    android:background="@drawable/shape_edittext_bg"
                                    android:hint="@string/hotspot_alias_hint"
                                    android:imeOptions="actionDone"
                                    android:inputType="textCapWords"
                                    android:paddingStart="8dp"
                                    android:paddingEnd="8dp"
                                    android:singleLine="true"
                                    android:textColor="?android:attr/textColorPrimary"
                                    android:textColorHint="?android:attr/textColorSecondary"
                                    android:textSize="13sp" />
                            </LinearLayout>

                            <!-- Row 2: Denied Radio Button & Remove Alias Button -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="38dp"
                                android:layout_marginTop="6dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <RadioButton
                                    android:id="@+id/hotspot_detail_radio_denied"
                                    android:layout_width="0dp"
                                    android:layout_height="match_parent"
                                    android:layout_weight="1"
                                    android:gravity="center_vertical"
                                    android:paddingStart="4dp"
                                    android:paddingEnd="4dp"
                                    android:text="@string/status_denied"
                                    android:textColor="?android:attr/textColorPrimary"
                                    android:textSize="13sp" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/hotspot_detail_btn_remove_alias"
                                    style="@style/Widget.MaterialComponents.Button.TextButton"
                                    android:layout_width="0dp"
                                    android:layout_height="match_parent"
                                    android:layout_marginStart="16dp"
                                    android:layout_weight="1"
                                    android:gravity="start|center_vertical"
                                    android:padding="0dp"
                                    android:text="@string/btn_remove_alias"
                                    android:textSize="11sp"
                                    android:visibility="gone" />
                            </LinearLayout>

                            <!-- Device Metrics -->
                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:layout_marginTop="10dp"
                                android:layout_marginBottom="10dp"
                                android:background="?attr/colorOutline"
                                android:alpha="0.1" />

                            <TextView
                                android:id="@+id/hotspot_detail_ip"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="?android:attr/textColorSecondary"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/hotspot_detail_data"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textColor="?android:attr/textColorSecondary"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/hotspot_detail_time"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textColor="?android:attr/textColorSecondary"
                                android:textSize="13sp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</com.witherboymcw.superbattery.awareness.NotchAwareFrameLayout>
