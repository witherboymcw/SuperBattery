<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <com.witherboymcw.superbattery.DashboardLayout
        android:id="@+id/dashboard"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <!-- Cột bên trái (Left Column) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="0dp"
            android:paddingEnd="8dp">

            <!-- Header -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start|center_vertical"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_header_clock"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFeatureSettings="tnum"
                        android:text="00:00:00"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <ImageButton
                        android:id="@+id/btn_ringer_mode_toggle"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="4dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Ringer Mode"
                        android:padding="8dp"
                        android:src="@drawable/ic_ringer_sound"
                        app:tint="?attr/colorControlNormal" />
                </LinearLayout>

                <TextView
                    android:id="@+id/dashboard_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginStart="48dp"
                    android:layout_marginEnd="48dp"
                    android:gravity="center"
                    android:text="@string/dashboard_title"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/settings_button"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="end|center_vertical"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/settings"
                    android:padding="12dp"
                    android:src="@drawable/ic_settings"
                    app:tint="?attr/colorControlNormal" />
            </FrameLayout>

            <!-- Hàng chỉ số nhanh (Metric Cards) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <include
                    android:id="@+id/card_battery"
                    layout="@layout/dashboard_metric_card"
                    android:layout_width="104dp"
                    android:layout_height="match_parent"
                    android:tag="battery" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_network"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="?attr/colorSurface"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="1dp"
                    app:strokeColor="?attr/colorOutline"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:padding="10dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:textAlignment="center"
                                android:includeFontPadding="false"
                                android:text="@string/network_stats"
                                android:textColor="?android:attr/textColorPrimary"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="0dp"
                                android:layout_weight="1"
                                android:gravity="center_vertical"
                                android:orientation="vertical">

                                <!-- Row 1: Upload (Tải lên) -->
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:id="@+id/net_tx_total"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:ellipsize="end"
                                        android:gravity="start"
                                        android:textAlignment="viewStart"
                                        android:includeFontPadding="false"
                                        android:maxLines="1"
                                        android:text="—"
                                        android:textSize="22sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="2dp"
                                        android:layout_marginEnd="2dp"
                                        android:gravity="center"
                                        android:includeFontPadding="false"
                                        android:text="↑"
                                        android:textColor="?android:attr/textColorSecondary"
                                        android:textSize="22sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:id="@+id/net_tx_speed"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:ellipsize="end"
                                        android:gravity="end"
                                        android:textAlignment="viewEnd"
                                        android:includeFontPadding="false"
                                        android:maxLines="1"
                                        android:text="—"
                                        android:textSize="22sp"
                                        android:textStyle="bold" />
                                </LinearLayout>

                                <!-- Row 2: Download (Tải xuống) -->
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:id="@+id/net_rx_total"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:ellipsize="end"
                                        android:gravity="start"
                                        android:textAlignment="viewStart"
                                        android:includeFontPadding="false"
                                        android:maxLines="1"
                                        android:text="—"
                                        android:textSize="22sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="2dp"
                                        android:layout_marginEnd="2dp"
                                        android:gravity="center"
                                        android:includeFontPadding="false"
                                        android:text="↓"
                                        android:textColor="?android:attr/textColorSecondary"
                                        android:textSize="22sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:id="@+id/net_rx_speed"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:ellipsize="end"
                                        android:gravity="end"
                                        android:textAlignment="viewEnd"
                                        android:includeFontPadding="false"
                                        android:maxLines="1"
                                        android:text="—"
                                        android:textSize="22sp"
                                        android:textStyle="bold" />
                                </LinearLayout>
                            </LinearLayout>
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_marginStart="6dp"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <FrameLayout
                                android:layout_width="wrap_content"
                                android:layout_height="0dp"
                                android:layout_weight="1">

                                <ImageView
                                    android:id="@+id/iv_network_wifi"
                                    android:layout_width="14dp"
                                    android:layout_height="14dp"
                                    android:layout_gravity="center"
                                    android:alpha="0.4"
                                    android:contentDescription="Wi-Fi"
                                    android:src="@drawable/ic_wifi"
                                    app:tint="?attr/colorControlNormal" />
                            </FrameLayout>

                            <FrameLayout
                                android:layout_width="wrap_content"
                                android:layout_height="0dp"
                                android:layout_weight="1">

                                <ImageView
                                    android:id="@+id/iv_network_bluetooth"
                                    android:layout_width="14dp"
                                    android:layout_height="14dp"
                                    android:layout_gravity="center"
                                    android:alpha="0.4"
                                    android:contentDescription="Bluetooth"
                                    android:src="@drawable/ic_bluetooth"
                                    app:tint="?attr/colorControlNormal" />
                            </FrameLayout>

                            <LinearLayout
                                android:id="@+id/layout_sim_signals"
                                android:layout_width="wrap_content"
                                android:layout_height="0dp"
                                android:layout_weight="1"
                                android:gravity="center">

                                <ImageView
                                    android:id="@+id/iv_network_sim_1"
                                    android:layout_width="14dp"
                                    android:layout_height="14dp"
                                    android:alpha="0.4"
                                    android:contentDescription="SIM Signal"
                                    android:src="@drawable/ic_signal_cellular"
                                    app:tint="?attr/colorControlNormal" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Biểu đồ Điện áp Pin (card_voltage_graph) tự co giãn chiếm phần còn lại -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_voltage_graph"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp"
                app:strokeColor="?attr/colorOutline"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <FrameLayout
                        android:id="@+id/header_voltage_graph"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="start|center_vertical"
                            android:gravity="start"
                            android:text="@string/voltage_title"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_voltage_power"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="end|center_vertical"
                            android:gravity="end"
                            android:text="@string/placeholder_dash"
                            android:textColor="?android:attr/textColorSecondary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/voltage_current"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="end|center_vertical"
                            android:gravity="end"
                            android:text="@string/placeholder_dash"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </FrameLayout>

                    <com.witherboymcw.superbattery.HistoryGraphView
                        android:id="@+id/voltage_graph"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:layout_marginTop="6dp"
                        android:padding="8dp"
                        android:contentDescription="@string/voltage_title" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- Cột bên phải (Right Column) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingEnd="0dp">

            <!-- Biểu đồ RAM (card_ram_graph) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_ram_graph"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp"
                app:strokeColor="?attr/colorOutline"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <FrameLayout
                        android:id="@+id/header_ram_graph"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="start|center_vertical"
                            android:gravity="start"
                            android:text="@string/ram_title"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/ram_current"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="end|center_vertical"
                            android:gravity="end"
                            android:text="@string/placeholder_dash"
                            android:textColor="?android:attr/textColorSecondary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_ram_usage_detail"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="end|center_vertical"
                            android:gravity="end"
                            android:text="@string/placeholder_dash"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </FrameLayout>

                    <com.witherboymcw.superbattery.HistoryGraphView
                        android:id="@+id/ram_graph"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:layout_marginTop="6dp"
                        android:padding="8dp"
                        android:contentDescription="@string/ram_title" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Biểu đồ Nhiệt độ Pin (card_temperature_graph) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_temperature_graph"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp"
                app:strokeColor="?attr/colorOutline"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <FrameLayout
                        android:id="@+id/header_temperature_graph"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="start|center_vertical"
                            android:gravity="start"
                            android:text="@string/temperature_title"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_temperature_status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="end|center_vertical"
                            android:gravity="end"
                            android:text="@string/placeholder_dash"
                            android:textColor="?android:attr/textColorSecondary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/temperature_current"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="end|center_vertical"
                            android:gravity="end"
                            android:text="@string/placeholder_dash"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </FrameLayout>

                    <com.witherboymcw.superbattery.HistoryGraphView
                        android:id="@+id/temperature_graph"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:layout_marginTop="6dp"
                        android:padding="8dp"
                        android:contentDescription="@string/temperature_title" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </com.witherboymcw.superbattery.DashboardLayout>

    <include layout="@layout/layout_settings" />
    <include layout="@layout/layout_hotspot" />
</FrameLayout>
