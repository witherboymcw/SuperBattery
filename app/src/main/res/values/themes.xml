<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.SuperBattery" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
    </style>

    <style name="Theme.SuperBattery" parent="Base.Theme.SuperBattery" />

    <style name="Theme.SuperBattery.Oled" parent="Theme.SuperBattery">
        <item name="android:colorBackground">#000000</item>
        <item name="android:windowBackground">#000000</item>
        <item name="colorSurface">#1C1B1F</item>
        <item name="colorSurfaceContainer">#211F26</item>
        <item name="colorSurfaceContainerHigh">#2B2930</item>
        <item name="colorSurfaceContainerHighest">#36343B</item>
        <item name="colorSurfaceContainerLow">#1D1B20</item>
        <item name="colorSurfaceContainerLowest">#0F0D13</item>
    </style>

    <style name="Theme.SuperBattery.AppWidgetContainerParent" parent="@android:style/Theme.DeviceDefault">
        <!-- Radius of the outer bound of widgets to make the rounded corners -->
        <item name="appWidgetRadius">16dp</item>
        <!--
        Radius of the inner view's bound of widgets to make the rounded corners.
        It needs to be 8dp or less than the value of appWidgetRadius
        -->
        <item name="appWidgetInnerRadius">8dp</item>
    </style>

    <style name="Theme.SuperBattery.AppWidgetContainer" parent="Theme.SuperBattery.AppWidgetContainerParent">
        <!-- Apply padding to avoid the content of the widget colliding with the rounded corners -->
        <item name="appWidgetPadding">16dp</item>
    </style>
</resources>